rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Reads the caller's user doc by uid — only valid after first-login linking
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isAuthorized() {
      return isAuthenticated() &&
        (getUserData().role == 'admin' || getUserData().role == 'volunteer');
    }

    // ── /invitations/{email} ───────────────────────────────────────────────
    // Admin pre-authorizes users here. Doc ID is the lowercase email address.
    // On first login, the app reads this, creates /users/{uid}, deletes this.
    match /invitations/{email} {
      allow read, write, delete: if isAdmin();
      // The invited person can read and delete their own invitation on login
      allow read:   if isAuthenticated() && request.auth.token.email.lower() == email;
      allow delete: if isAuthenticated() && request.auth.token.email.lower() == email;
    }

    // ── /users/{uid} ───────────────────────────────────────────────────────
    match /users/{userId} {
      // User can read their own doc; admin can read any
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      // User creates their own doc on first login (converting an invitation)
      // Invitation must exist server-side — prevents self-granting any role
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()));

      // Anyone signing in without an invitation self-registers as a parishioner.
      // The role is pinned here so it can never be escalated from the client.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'parishioner'
        && request.resource.data.email == request.auth.token.email.lower();

      // User can only update their own lastLoginAt; admin can update anything
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastLoginAt']);
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ── /books/{bookId} ────────────────────────────────────────────────────
    match /books/{bookId} {
      // Public read — book catalog is not sensitive; students browse without login
      allow read: if true;
      // Admin manages books; volunteers only update availableCopies (checkout/checkin)
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
      allow update: if isAuthorized() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['availableCopies', 'updatedAt']);
    }

    // ── /students/{studentId} ──────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();
    }

    // ── /checkouts/{checkoutId} ────────────────────────────────────────────
    match /checkouts/{checkoutId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized();
      // Only status and returnedAt may change after creation (checkin operation)
      allow update: if isAuthorized() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'returnedAt']);
      allow delete: if isAdmin();
    }

    // ── /donationBooks/{bookId} ────────────────────────────────────────────
    // The donation drive wishlist. Public so parishioners can browse before
    // signing in; staff import, edit, and delete entries.
    match /donationBooks/{bookId} {
      allow read: if true;
      allow create, delete: if isAuthorized();
      allow update: if isAuthorized();
      // A signed-in parishioner pledging or cancelling only moves the counter,
      // and never past the number of copies the library asked for.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claimedCount', 'updatedAt']) &&
        request.resource.data.claimedCount >= 0 &&
        request.resource.data.claimedCount <= resource.data.qty;
    }

    // ── /donationClaims/{claimId} ──────────────────────────────────────────
    // Public pledge record. Carries displayName only — blank when the donor
    // asked to stay anonymous — so no identity leaks through a public read.
    match /donationClaims/{claimId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.donorUid == request.auth.uid
        && request.resource.data.status == 'pledged'
        && request.resource.data.qty is int
        && request.resource.data.qty > 0;
      // Staff mark received or remove pledges; donors may withdraw their own
      allow delete: if isAuthorized() ||
        (isAuthenticated() && resource.data.donorUid == request.auth.uid);
      allow update: if isAuthorized() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // ── /donationContacts/{claimId} ────────────────────────────────────────
    // Donor name, email and phone. Readable by staff and the donor only,
    // which is what lets a pledge be publicly anonymous but still traceable.
    match /donationContacts/{claimId} {
      allow read: if isAuthorized() ||
        (isAuthenticated() && resource.data.donorUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.donorUid == request.auth.uid;
      allow delete: if isAuthorized() ||
        (isAuthenticated() && resource.data.donorUid == request.auth.uid);
    }
  }
}
